# Required for Meta WhatsApp Cloud API
WHATSAPP_TOKEN=replace_with_a_permanent_meta_system_user_token
PHONE_NUMBER_ID=replace_with_your_meta_phone_number_id
VERIFY_TOKEN=replace_with_a_long_random_webhook_verify_token
# Strongly recommended: Meta app secret used to verify x-hub-signature-256.
META_APP_SECRET=replace_with_your_meta_app_secret
GRAPH_API_VERSION=v26.0

# Business identity and booking details
BUSINESS_NAME=Glam by Thandi
CURRENCY=R
TIME_ZONE=Africa/Johannesburg
OWNER_WHATSAPP=27720000000
HOUSE_CALL_FEE_MIN=80
HOUSE_CALL_FEE_MAX=150
LOAD_SHEDDING_MESSAGE=Please note: appointments may be affected by load-shedding. We will confirm your booking before your visit.

# Required for durable booking capture on Render. Deploy the included Apps Script endpoint,
# then paste its Web App URL here. Do not use a Google Sheet URL or Sheet ID.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_a_long_random_shared_secret

# Optional: replace the default service menu without changing code.
# SERVICES_JSON=[{"id":"braids","name":"Knotless braids","price":450},{"id":"wig-install","name":"Wig installation","price":350}]

# Render supplies PORT automatically. Only needed for local testing.
PORT=3000
